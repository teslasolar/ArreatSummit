---
layout: layouts/base.njk
title: Unique Items
---

<h1 class="text-4xl font-bold text-blue-400 mb-8">Unique Items</h1>

<div class="grid gap-6">
  {% for unique in uniques %}
  <div id="{{ unique._id }}" class="bg-gray-800 rounded-lg p-6 border border-blue-600 hover:border-blue-500 transition-colors scroll-mt-20">
    <div class="flex justify-between items-start mb-4">
      <div>
        <h2 class="text-2xl font-bold text-blue-400">
          <a href="#{{ unique._id }}" class="hover:text-blue-300">{{ unique.name }}</a>
        </h2>
        <p class="text-gray-400">{{ unique.base }}</p>
      </div>
      {% if unique.req and unique.req.level %}
      <span class="text-sm bg-gray-700 px-3 py-1 rounded">
        Req Level {{ unique.req.level }}
      </span>
      {% endif %}
    </div>

    <div class="mb-4 text-sm text-gray-400">
      {% if unique.qlvl %}
      <p><strong>Quality Level:</strong> {{ unique.qlvl }}</p>
      {% endif %}
      {% if unique.tc %}
      <p><strong>Treasure Class:</strong> {{ unique.tc }}</p>
      {% endif %}
    </div>

    <div class="space-y-1">
      {% for stat in unique.stats %}
      <div class="text-blue-300">
        {{ stat.text }}: {{ stat | statValue }}
      </div>
      {% endfor %}
    </div>

    <p class="mt-4 text-xs text-gray-600">Patch {{ unique._meta.patch }}</p>
  </div>
  {% endfor %}
</div>
