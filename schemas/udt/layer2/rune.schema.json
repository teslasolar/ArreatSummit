{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arreatsummit.com/schemas/udt/layer2/rune.schema.json",
  "title": "Rune UDT",
  "description": "Rune definition",
  "type": "object",
  "required": ["name", "num", "level"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Rune name (e.g., 'Tal', 'Ort')"
    },
    "num": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33,
      "description": "Rune number (1-33)"
    },
    "level": {
      "type": "integer",
      "description": "Required level to equip"
    },
    "weapon": {
      "type": "array",
      "items": { "$ref": "../layer1/stat.schema.json" },
      "description": "Stats when socketed in weapon"
    },
    "armor": {
      "type": "array",
      "items": { "$ref": "../layer1/stat.schema.json" },
      "description": "Stats when socketed in armor/helm"
    },
    "shield": {
      "type": "array",
      "items": { "$ref": "../layer1/stat.schema.json" },
      "description": "Stats when socketed in shield"
    }
  }
}
