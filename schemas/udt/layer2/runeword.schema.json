{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arreatsummit.com/schemas/udt/layer2/runeword.schema.json",
  "title": "Runeword UDT",
  "description": "Runeword definition",
  "type": "object",
  "required": ["name", "slug", "runes", "sockets", "types", "stats"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Runeword name"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "runes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "Rune names in order"
    },
    "sockets": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6
    },
    "types": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Allowed base types"
    },
    "req": {
      "$ref": "../layer1/req.schema.json"
    },
    "stats": {
      "type": "array",
      "items": { "$ref": "../layer1/stat.schema.json" }
    },
    "stats_var": {
      "type": "object",
      "description": "Variable stats by item type"
    },
    "ladder": {
      "type": "boolean",
      "description": "Ladder-only"
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
