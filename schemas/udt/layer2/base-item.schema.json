{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arreatsummit.com/schemas/udt/layer2/base-item.schema.json",
  "title": "BaseItem UDT",
  "description": "Base item properties",
  "type": "object",
  "required": ["name", "slug", "type", "subtype"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Item name"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "type": {
      "type": "string",
      "enum": ["weapon", "armor", "jewelry", "misc"]
    },
    "subtype": {
      "type": "string",
      "description": "Specific type (sword, helm, ring, etc.)"
    },
    "tier": {
      "type": "string",
      "enum": ["normal", "exceptional", "elite"],
      "description": "Item tier"
    },
    "req": {
      "$ref": "../layer1/req.schema.json"
    },
    "sockets": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 6
    }
  }
}
