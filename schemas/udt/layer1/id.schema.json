{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arreatsummit.com/schemas/udt/layer1/id.schema.json",
  "title": "ID UDT",
  "description": "Standard identifier with name, slug, and patch",
  "type": "object",
  "required": ["name", "slug"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "URL-safe identifier"
    },
    "patch": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Patch version (e.g., 2.4)"
    }
  }
}
