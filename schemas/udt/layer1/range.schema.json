{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arreatsummit.com/schemas/udt/layer1/range.schema.json",
  "title": "Range UDT",
  "description": "Numeric range with min/max/varies",
  "type": "object",
  "required": ["min", "max"],
  "properties": {
    "min": {
      "type": "number",
      "description": "Minimum value"
    },
    "max": {
      "type": "number",
      "description": "Maximum value"
    },
    "varies": {
      "type": "boolean",
      "description": "Whether value varies (default: true if min != max)"
    }
  }
}
