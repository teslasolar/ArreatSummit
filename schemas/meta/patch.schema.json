{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arreatsummit.com/schemas/meta/patch.schema.json",
  "title": "PATCH - Entity Modification",
  "description": "Defines changes to an entity across patches using JSON Patch (RFC 6902)",
  "type": "object",
  "required": ["meta", "operations"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "meta": {
      "type": "object",
      "required": ["type", "target", "patch"],
      "properties": {
        "type": {
          "type": "string",
          "const": "PATCH"
        },
        "target": {
          "type": "string",
          "description": "Entity ID to patch"
        },
        "patch": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Patch version"
        },
        "description": {
          "type": "string",
          "description": "What changed"
        }
      }
    },
    "operations": {
      "type": "array",
      "description": "JSON Patch operations",
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": {
            "type": "string",
            "enum": ["add", "remove", "replace", "move", "copy", "test"]
          },
          "path": { "type": "string" },
          "value": {}
        }
      }
    }
  }
}
